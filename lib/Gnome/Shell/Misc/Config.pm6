use v6.c;

unit package Gnome::Shell::Misc::Config;

our constant PACKAGE_NAME          is export = 'gnome-shell';
our constant LIBEXECDIR            is export = '/usr/libexec';
our constant LOCALEDIR             is export = '/usr/share/locale';
our constant PKGDATADIR            is export = '/usr/share/gnome-shell';
our constant GETTEXT_PACKAGE       is export = 'gnome-shell';
our constant HAVE_NETWORKMANAGER   is export = 1;
our constant LIBMUTTER_API_VERSION is export = '14';
